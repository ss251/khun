{
  "name": "khun",
  "private": true,
  "version": "0.1.0",
  "description": "Thai LINE bot turns any service provider into a Solana mainnet x402-payable AI agent. SEABW 2026 hackathon.",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:line": "bun --watch packages/line-bot/src/local.ts",
    "dev:dashboard": "cd packages/dashboard && bun run dev",
    "build:line": "cd packages/line-bot && bun run build",
    "deploy:line": "cd packages/line-bot && bun run deploy",
    "register-agent": "bun packages/agent-creator/src/cli.ts",
    "typecheck": "bun --bun tsc -b"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "esbuild": "^0.25.0"
  }
}
