# Copy to .env (gitignored) or `export` these in your shell.

# --- Claude (Anthropic) ---
# Set EITHER ANTHROPIC_API_KEY (direct Anthropic API, preferred when present)
# OR AWS_BEARER_TOKEN_BEDROCK (Bedrock path; needs model access approved).
# packages/line-bot/src/claude.ts auto-selects: ANTHROPIC_API_KEY wins if set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-opus-4-7

# --- AWS Bedrock (fallback path; works once model access is approved) ---
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-7-20250000-v1:0

# --- SCB 10X / Typhoon ---
# Get from https://playground.opentyphoon.ai/ (Playground > API Keys)
TYPHOON_API_KEY=
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL_ID=typhoon-v2.5-30b-a3b-instruct

# --- Telegram Bot (pivoted from LINE) ---
# Create a bot: open Telegram → message @BotFather → /newbot → follow prompts.
# Copy the HTTP API token it gives you (looks like 7123456789:AA...) into TELEGRAM_BOT_TOKEN.
# TELEGRAM_SECRET_TOKEN: any random 32+ char string you choose; we send it to Telegram
# at setWebhook time and verify it on every incoming request.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=

# --- Solana mainnet ---
# Helius / QuickNode / Triton recommended for mainnet reliability
SOLANA_RPC_URL=
TREASURY_KEYPAIR_PATH=./.keys/treasury.json
USDT_SOLANA_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# --- agent-registry-8004 (Quantu Labs SDK) ---
AGENT_REGISTRY_INDEXER=https://8004-indexer-main.qnt.sh/v2/graphql
AGENT_REGISTRY_CLUSTER=mainnet-beta

# --- Turnkey (embedded wallets) ---
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=

# --- Pinata (IPFS for agent metadata; required by 8004-solana SDK) ---
PINATA_JWT=

# --- Bitkub ---
BITKUB_API_BASE=https://api.bitkub.com
