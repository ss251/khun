# Shared secrets — copy to .env (gitignored).
#
# Cluster-specific values (RPC URL, indexer, cluster name) live in:
#   .env.devnet     — loaded by default (or when KHUN_ENV=devnet)
#   .env.mainnet    — loaded when KHUN_ENV=mainnet
# Examples in .env.devnet.example / .env.mainnet.example.
#
# Load order in packages/shared/src/env.ts:
#   .env  →  .env.<KHUN_ENV>   (later wins; both override shell env)

# --- Claude (Anthropic) ---
# Set EITHER ANTHROPIC_API_KEY (direct Anthropic API, preferred when present)
# OR AWS_BEARER_TOKEN_BEDROCK (Bedrock path; needs model access approved).
# packages/bot/src/claude.ts auto-selects: ANTHROPIC_API_KEY wins if set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-opus-4-7

# --- AWS Bedrock (fallback path; works once model access is approved) ---
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-7-20250000-v1:0

# --- SCB 10X / Typhoon ---
# https://playground.opentyphoon.ai/  →  Playground > API Keys
TYPHOON_API_KEY=
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL_ID=typhoon-v2.5-30b-a3b-instruct

# --- Telegram Bot ---
# @BotFather → /newbot → token.  TELEGRAM_SECRET_TOKEN: any random 32+ char string.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=

# --- Khun master seed (HKDF root for per-merchant Ed25519 keypairs) ---
# `openssl rand -hex 32` once and never rotate (rotating orphans every merchant).
KHUN_MASTER_SEED=

# --- Solana shared ---
TREASURY_KEYPAIR_PATH=./.keys/treasury.json
USDT_SOLANA_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# --- Pinata IPFS (used by 8004-solana SDK to upload agent metadata) ---
# pinata.cloud → API Keys → New Key → enable pinJSONToIPFS → copy the JWT.
PINATA_JWT=

# --- Bitkub ---
BITKUB_API_BASE=https://api.bitkub.com
